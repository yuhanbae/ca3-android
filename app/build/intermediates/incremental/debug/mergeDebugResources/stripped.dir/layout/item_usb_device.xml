<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/slate_900"
    android:layout_marginBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/deviceVidPid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VID:PID"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/ca3_amber_light"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/deviceClass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Class: 0x00"
            android:textSize="11sp"
            android:textColor="@color/slate_500"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/deviceSelected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="▸ SELECT"
            android:textSize="11sp"
            android:textColor="@color/ok_green"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/deviceProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Product Name"
        android:textSize="12sp"
        android:textColor="@color/ink_200"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/deviceManufacturer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Manufacturer"
        android:textSize="11sp"
        android:textColor="@color/slate_500" />

    <TextView
        android:id="@+id/deviceInterfaces"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Interfaces: 0"
        android:textSize="11sp"
        android:textColor="@color/slate_500"
        android:fontFamily="monospace" />
</LinearLayout>